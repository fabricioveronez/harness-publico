---
interface Props {
  plugin: string;
  href?: string;
  class?: string;
}
const { plugin, href, class: klass = '' } = Astro.props;
const base =
  'inline-flex items-center rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-500/10 dark:text-brand-300';
---
{
  href ? (
    <a href={href} class={`${base} hover:bg-brand-100 dark:hover:bg-brand-500/20 ${klass}`}>{plugin}</a>
  ) : (
    <span class={`${base} ${klass}`}>{plugin}</span>
  )
}
