---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkillCard from '../components/SkillCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { site } from '../site.config';

const skills = (await getCollection('skills')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const plugins = (await getCollection('plugins')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const counts = plugins.map((p) => ({
  name: p.id,
  count: skills.filter((s) => s.data.plugin.id === p.id).length,
}));
const pending = skills.filter((s) => !s.data.hasDoc).length;
---
<Base>
  <section class="mb-6">
    <div class="flex items-center gap-3">
      <img src={`${import.meta.env.BASE_URL}${site.logo.replace(/^\//, '')}`} alt="" class="h-10 w-10 shrink-0 rounded-lg" />
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{site.name}</h1>
    </div>
    <p class="mt-1 text-zinc-600 dark:text-zinc-400">{site.tagline}</p>
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-500">
      {plugins.length} plugins · {skills.length} skills{pending > 0 && ` · ${pending} sem documentação`}
    </p>
  </section>

  <div class="flex flex-col gap-8 md:flex-row">
    <CategoryFilter plugins={counts} total={skills.length} />
    <section id="skill-list" class="min-w-0 flex-1">
      {skills.map((s) => (
        <SkillCard row id={s.id} name={s.data.name} plugin={s.data.plugin.id} blurb={s.data.blurb} hasDoc={s.data.hasDoc} />
      ))}
    </section>
  </div>
</Base>
